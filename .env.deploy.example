# Copy values into Vercel Environment Variables (DJANGO_ENV=production).
# Use Supabase Transaction pooler (port 6543), not Session 5432.
DB_NAME=postgres
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=your-supabase-db-password
DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
DB_PORT=6543
DB_SSLMODE=require
