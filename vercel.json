{
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.py" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{api,config,accounts,core,institutions,receipts,payments,partners,wages,reports}/**",
      "excludeFiles": "{.venv,.git,**/__pycache__}/**"
    }
  }
}
